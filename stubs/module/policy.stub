<?php

declare(strict_types=1);

namespace App\Policies;

use App\Models\{{ Model }};
use App\Models\User;

/**
 * Generated by `php artisan make:module {{ Model }}`. Super admins pass every
 * check before this runs; everyone else needs the {{ permission }}.* permission.
 */
final class {{ Model }}Policy
{
    public function viewAny(User $user): bool
    {
        return $user->can('{{ permission }}.view');
    }

    public function view(User $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user->can('{{ permission }}.view');
    }

    public function create(User $user): bool
    {
        return $user->can('{{ permission }}.create');
    }

    public function update(User $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user->can('{{ permission }}.update');
    }

    public function delete(User $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user->can('{{ permission }}.delete');
    }

    public function deleteAny(User $user): bool
    {
        return $user->can('{{ permission }}.delete');
    }
{{#softDeletes}}

    public function restore(User $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user->can('{{ permission }}.restore');
    }

    public function restoreAny(User $user): bool
    {
        return $user->can('{{ permission }}.restore');
    }

    /** Only super admins erase records for good. */
    public function forceDelete(User $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return false;
    }

    public function forceDeleteAny(User $user): bool
    {
        return false;
    }
{{/softDeletes}}
}
