it('keeps people without {{ permission }}.view out', function (): void {
    $this->actingAs(userWithRole(SystemRole::User));

    $this->get('/app/{{ uri }}')->assertForbidden();
});

it('lists {{ pluralLabel }} for admins', function (): void {
    $this->actingAs(userWithRole(SystemRole::Admin));
    $records = {{ Model }}::factory()->count(3)->create();

    livewire(List{{ Models }}::class)->assertCanSeeTableRecords($records);
});

it('creates a {{ label }}', function (): void {
    $this->actingAs(userWithRole(SystemRole::Admin));

    livewire(Create{{ Model }}::class)
        ->fillForm({{ modelVariable }}FormData())
        ->call('create')
        ->assertHasNoFormErrors();

    expect({{ Model }}::query()->count())->toBe(1);
});
{{#hasRequired}}

it('requires {{ requiredField }}', function (): void {
    $this->actingAs(userWithRole(SystemRole::Admin));

    livewire(Create{{ Model }}::class)
        ->fillForm([...{{ modelVariable }}FormData(), '{{ requiredField }}' => null])
        ->call('create')
        ->assertHasFormErrors(['{{ requiredField }}' => 'required']);
});
{{/hasRequired}}

{{#hasUnique}}
it('refuses a duplicate {{ uniqueField }}', function (): void {
    $this->actingAs(userWithRole(SystemRole::Admin));
    $existing = {{ Model }}::factory()->create();

    livewire(Create{{ Model }}::class)
        ->fillForm([...{{ modelVariable }}FormData(), '{{ uniqueField }}' => $existing->{{ uniqueField }}])
        ->call('create')
        ->assertHasFormErrors(['{{ uniqueField }}' => 'unique']);
});

{{/hasUnique}}
it('shows and updates a {{ label }}', function (): void {
    $this->actingAs(userWithRole(SystemRole::Admin));
    ${{ modelVariable }} = {{ Model }}::factory()->create();

    livewire(View{{ Model }}::class, ['record' => ${{ modelVariable }}->getRouteKey()])->assertOk();

    livewire(Edit{{ Model }}::class, ['record' => ${{ modelVariable }}->getRouteKey()])
        ->fillForm({{ modelVariable }}FormData())
        ->call('save')
        ->assertHasNoFormErrors();

    expect(${{ modelVariable }}->fresh()?->updated_at)->not->toBeNull();
});

it('deletes a {{ label }}', function (): void {
    $this->actingAs(userWithRole(SystemRole::Admin));
    ${{ modelVariable }} = {{ Model }}::factory()->create();

    livewire(List{{ Models }}::class)->callAction(TestAction::make('delete')->table(${{ modelVariable }}));

{{#softDeletes}}
    expect({{ Model }}::withTrashed()->find(${{ modelVariable }}->id)?->trashed())->toBeTrue();
{{/softDeletes}}
{{^softDeletes}}
