it('lists {{ pluralLabel }} with pages', function (): void {
    {{ Model }}::factory()->count(3)->create();

    asApiUser(userWithRole(SystemRole::Admin))->getJson('/api/v1/{{ uri }}?per_page=2')
        ->assertOk()
        ->assertJsonCount(2, 'data')
        ->assertJsonPath('meta.total', 3);
});

it('keeps people without {{ permission }}.view out', function (): void {
    asApiUser(userWithRole(SystemRole::User))->getJson('/api/v1/{{ uri }}')->assertForbidden();
});

it('holds a token to its abilities', function (): void {
    asApiUser(userWithRole(SystemRole::Admin), ['{{ permission }}.view'])->postJson('/api/v1/{{ uri }}', {{ modelVariable }}ApiData())->assertForbidden();
});

it('creates, shows, updates and deletes a {{ label }}', function (): void {
    $admin = userWithRole(SystemRole::Admin);

    $id = asApiUser($admin)->postJson('/api/v1/{{ uri }}', {{ modelVariable }}ApiData())->assertCreated()->json('data.id');

    asApiUser($admin)->getJson("/api/v1/{{ uri }}/{$id}")->assertOk()->assertJsonPath('data.id', $id);
    asApiUser($admin)->patchJson("/api/v1/{{ uri }}/{$id}", {{ modelVariable }}ApiData())->assertOk();
    asApiUser($admin)->deleteJson("/api/v1/{{ uri }}/{$id}")->assertNoContent();
{{#softDeletes}}

    asApiUser($admin)->postJson("/api/v1/{{ uri }}/{$id}/restore")->assertOk();
{{/softDeletes}}
});
{{#hasRequired}}

it('refuses a {{ label }} without {{ requiredField }}', function (): void {
    asApiUser(userWithRole(SystemRole::Admin))->postJson('/api/v1/{{ uri }}', [...{{ modelVariable }}ApiData(), '{{ requiredField }}' => null])
        ->assertUnprocessable()
        ->assertJsonValidationErrors('{{ requiredField }}');
});
{{/hasRequired}}
