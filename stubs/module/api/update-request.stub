<?php

declare(strict_types=1);

namespace App\Http\Requests\Api\V1;

use App\Models\{{ Model }};
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

final class Update{{ Model }}Request extends FormRequest
{
    public function authorize(): bool
    {
        ${{ modelVariable }} = $this->route('{{ routeParameter }}');

        return ${{ modelVariable }} instanceof {{ Model }} && ($this->user()?->can('update', ${{ modelVariable }}) ?? false);
    }

    /**
     * Only the fields sent are checked and changed.
     *
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
{{ updateRules }}
        ];
    }
}
