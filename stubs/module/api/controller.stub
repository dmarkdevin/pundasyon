<?php

declare(strict_types=1);

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Http\Requests\Api\V1\Store{{ Model }}Request;
use App\Http\Requests\Api\V1\Update{{ Model }}Request;
use App\Http\Resources\V1\{{ Model }}Resource;
use App\Models\{{ Model }};
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\Gate;
use Spatie\QueryBuilder\AllowedFilter;
use Spatie\QueryBuilder\QueryBuilder;

/**
 * Generated by `php artisan make:module {{ Model }}`.
 *
 * @tags {{ Models }}
 */
final class {{ Model }}Controller extends Controller
{
    /**
     * List {{ pluralLabel }}.
     *
     * Filters: {{ filterList }}. Sort by {{ sortList }}; prefix with `-` for descending (default `-created_at`).
     */
    public function index(Request $request): AnonymousResourceCollection
    {
        Gate::authorize('viewAny', {{ Model }}::class);

        ${{ models }} = QueryBuilder::for({{ Model }}::class)
            ->allowedFilters(
{{ apiFilters }}
            )
            ->allowedSorts({{ apiSorts }})
            ->defaultSort('-created_at'){{ eagerLoad }}
            ->paginate(UserController::perPage($request))
            ->withQueryString();

        return {{ Model }}Resource::collection(${{ models }});
    }

    /**
     * Create a {{ label }}.
     */
    public function store(Store{{ Model }}Request $request): JsonResponse
    {
        ${{ modelVariable }} = {{ Model }}::query()->create($request->validated());

        return (new {{ Model }}Resource(${{ modelVariable }}{{ loadRelations }}))->response()->setStatusCode(201);
    }

    /**
     * Show a {{ label }}.
     */
    public function show({{ Model }} ${{ modelVariable }}): {{ Model }}Resource
    {
        Gate::authorize('view', ${{ modelVariable }});

        return new {{ Model }}Resource(${{ modelVariable }}{{ loadRelations }});
    }

    /**
     * Update a {{ label }}. Only the fields you send change.
     */
    public function update(Update{{ Model }}Request $request, {{ Model }} ${{ modelVariable }}): {{ Model }}Resource
    {
        ${{ modelVariable }}->update($request->validated());

        return new {{ Model }}Resource(${{ modelVariable }}{{ loadRelations }});
    }

    /**
     * Delete a {{ label }}.{{#softDeletes}} It can be undone with restore.{{/softDeletes}}
     */
    public function destroy({{ Model }} ${{ modelVariable }}): Response
    {
        Gate::authorize('delete', ${{ modelVariable }});
        ${{ modelVariable }}->delete();

        return response()->noContent();
    }
{{#softDeletes}}

    /**
     * Restore a deleted {{ label }}.
     */
    public function restore({{ Model }} ${{ modelVariable }}): {{ Model }}Resource
    {
        Gate::authorize('restore', ${{ modelVariable }});
        ${{ modelVariable }}->restore();

        return new {{ Model }}Resource(${{ modelVariable }}{{ loadRelations }});
    }
{{/softDeletes}}
}
