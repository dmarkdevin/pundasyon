APP_NAME=Pundasyon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8087
# Times are stored in UTC and shown in this zone, for example Asia/Manila.
APP_DISPLAY_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# These match Laravel Sail's MySQL service. For PostgreSQL use DB_CONNECTION=pgsql.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pundasyon
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sail's Mailpit catches every email; see them at http://localhost:8031. Use your mail service on a server.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pundasyon.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local ports for Sail. Change them if something else on your computer already uses them.
APP_PORT=8087
VITE_PORT=5187
FORWARD_DB_PORT=33087
FORWARD_MAILPIT_PORT=1031
FORWARD_MAILPIT_DASHBOARD_PORT=8031

# Security (see config/security.php). HTTPS redirects and HSTS only apply in production.
SECURITY_FORCE_HTTPS=true
SECURITY_LOGIN_HISTORY_DAYS=180
# Behind a load balancer or proxy, list its addresses (comma-separated) or use *.
TRUSTED_PROXIES=
ACTIVITYLOG_CLEAN_AFTER_DAYS=365
SETTINGS_CACHE_ENABLED=true
API_RATE_LIMIT=60
API_LOGIN_RATE_LIMIT=5
CORS_ALLOWED_ORIGINS=
API_VERSION=1.0.0
API_LOGIN_RATE_LIMIT_PER_ADDRESS=20
